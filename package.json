{
  "name": "svelte-querybuilder-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run --filter svelte-querybuilder build",
    "dev": "bun run --filter svelte-querybuilder dev",
    "check": "bun run --filter svelte-querybuilder check && bun run --filter '@svelte-querybuilder/example-*' check",
    "check:exports": "bun run --filter svelte-querybuilder check:exports",
    "check:all": "bun fmt:check && bun run build && bun run check && bun run check:exports && bun lint && bun run test:coverage && bun run conformance && bun run test:ssr",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ssr": "bun run build && bun run --filter @svelte-querybuilder/example-sveltekit test:ssr",
    "test:coverage": "vitest run --coverage",
    "conformance": "bun run --filter svelte-querybuilder conformance"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "jsdom": "^30.1.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "sass": "^1.105.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vitest-axe": "^0.1.0"
  }
}
