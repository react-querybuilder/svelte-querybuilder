{
  "name": "svelte-querybuilder",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Svelte component for complex query building",
  "keywords": [
    "svelte",
    "query",
    "builder",
    "query-builder",
    "filter",
    "sql"
  ],
  "author": "Jake Boone",
  "homepage": "https://github.com/react-querybuilder/svelte-querybuilder",
  "bugs": {
    "url": "https://github.com/react-querybuilder/svelte-querybuilder/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/react-querybuilder/svelte-querybuilder.git",
    "directory": "packages/svelte-querybuilder"
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "exports": {
    ".": {
      "svelte": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun run build:main && bun run build:css",
    "build:main": "svelte-package -i src/lib -o dist && find dist \\( -name '*.test.*' -o -name '*.spec.*' \\) -delete",
    "build:css": "mkdir -p dist/styles && cp ../../node_modules/@react-querybuilder/core/dist/*.scss dist && cp ../../node_modules/@react-querybuilder/core/dist/styles/*.scss dist/styles && cp -f src/lib/styles/*.scss dist/styles 2>/dev/null || true; bun sass --style=compressed dist",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "peerDependencies": {
    "svelte": "^5.25"
  },
  "dependencies": {
    "@react-querybuilder/core": "^8.22"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
