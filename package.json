{
  "name": "svelte-querybuilder-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run --filter svelte-querybuilder build",
    "dev": "bun run --filter svelte-querybuilder dev",
    "check": "bun run --filter svelte-querybuilder check && bun run --filter '@svelte-querybuilder/example-*' check",
    "check:exports": "bun run --filter svelte-querybuilder check:exports",
    "check:all": "bun fmt:check && bun run build && bun run check && bun run check:exports && bun lint && bun run test:coverage && bun run conformance && bun run test:ssr",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ssr": "bun run build && bun run --filter @svelte-querybuilder/example-sveltekit test:ssr",
    "test:coverage": "vitest run --coverage",
    "conformance": "bun run --filter svelte-querybuilder conformance"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.5",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/package": "^3.0.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.13",
    "@types/bun": "^1.4.5",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "jsdom": "^31.0.1",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "sass": "^1.108.2",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "^6",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vitest-axe": "^0.1.0"
  }
}
