{
  "name": "svelte-querybuilder-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run --filter svelte-querybuilder build",
    "check": "bun run --filter svelte-querybuilder check && bun run --filter '@svelte-querybuilder/example-*' check",
    "check:exports": "bun run --filter svelte-querybuilder check:exports",
    "check:all": "bun fmt:check && bun run build && bun run check && bun run check:exports && bun lint && bun run test:coverage && bun run conformance && bun run test:ssr",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ssr": "bun run build && bun run --filter @svelte-querybuilder/example-sveltekit test:ssr",
    "test:coverage": "vitest run --coverage",
    "conformance": "bun run --filter svelte-querybuilder conformance"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "sass": "^1.102.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0"
  }
}
