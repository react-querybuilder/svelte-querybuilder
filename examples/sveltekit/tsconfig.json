{
  // Extends SvelteKit's built-in config, not `tsconfig.base.json` -- Kit owns path aliases,
  // `rootDirs`, and module resolution here.
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "strict": true,
    "verbatimModuleSyntax": true,
    // Matches the `create-svelte` template default. Required here because
    // `@react-querybuilder/core`'s declarations carry type-only imports of its optional
    // integrations (`json-logic-js`, `drizzle-orm`, `sequelize`, `@tanstack/db`), none of which
    // are installed. Kit's config does not set this.
    "skipLibCheck": true
  },
  "include": ["src", "test", "*"],
  "exclude": ["src/service-worker"]
}
