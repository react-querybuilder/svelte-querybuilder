{
  // Extends SvelteKit's built-in config, not `tsconfig.base.json` -- Kit owns `rootDirs`,
  // and module resolution for the playground under `src/routes`. The options below restate the
  // ones this monorepo cares about that Kit's config does not set.
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "checkJs": true,
    "declaration": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    // `@react-querybuilder/core`'s declarations carry type-only imports of its optional
    // integrations (`drizzle-orm`, `sequelize`, `@tanstack/db`), none of which are installed.
    "skipLibCheck": true,
    "types": ["$app/types", "vitest/globals", "@testing-library/jest-dom", "bun"]
  },
  "include": ["src", "test", "scripts", "*"],
  "exclude": ["src/service-worker", "dist", "node_modules"]
}
